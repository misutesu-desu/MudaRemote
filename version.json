{
  "version": "4.8.4",
  "changelog": {
    "Bug Fixes": [
      "Auto $dk no longer fires from power estimates distorted by unconfirmed or losing Kakera clicks.",
      "Kakera power is committed only after Mudae posts the matching account-specific $k result.",
      "$rolls and $rt now wait for Mudae's checkmark reaction instead of assuming success after a fixed delay."
    ],
    "Improvements": [
      "Pending Kakera clicks reserve estimated power safely and fall back to a status reconciliation only when confirmation is missing.",
      "Successful $rt acknowledgements restore the local claim state immediately so rolling can continue without a redundant status wait."
    ]
  },
