{
  "version": "4.9.0-beta.18",
  "changelog": {
    "Bug Fixes": [
      "Accounts that receive usable rolls later in the same cycle can now resume their scheduled roll action instead of repeatedly checking $tu.",
      "Running multiple presets together can no longer incorrectly interfere with another account's authoritative roll state and roll timing.",
      "Claim-timed rolls now use consistent status checks from scheduling through actual execution."
    ],
    "Improvements": [
      "Unrelated status updates no longer unnecessarily block an already valid normal-roll action.",
      "Shared server timing can be reused across presets without erasing another account's authoritative roll count.",
      "Scheduling and execution now agree on which claim/roll changes require a fresh $tu reconciliation."
    ]
  },
