{
  "version": "4.7.0",
  "changelog": {
    "Bug Fixes": [
      "Kakera farming can use $rt on the farm character again after a confirmed forcedivorce.",
      "Rejected stale claims no longer trigger repeated $tu checks when neither a claim right nor $rt is ready.",
      "Localized $oh and $oc boards are detected without relying on English board text.",
      "Portuguese $p ready states and cooldown completions now trigger reliably."
    ],
    "Improvements": [
      "$oh now grants the extra click when a separate result message reports that spD turned into spP.",
      "$p cooldowns schedule a fresh status check when they expire."
    ]
  },
