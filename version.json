{
  "version": "4.8.5",
  "changelog": {
    "Bug Fixes": [
      "Successful slash $tu requests are no longer retried or replaced with a duplicate text command when Discord returns an empty response.",
      "Free Purple Kakera is always attempted when collection is enabled, even before the account has checked $tu.",
      "Immediate Mudae $ku responses now block already queued regular Kakera clicks for that account instead of allowing reaction spam.",
      "KakeraC bonus rolls are credited only to the account whose collection Mudae confirmed.",
      "Reactive rolling now resumes its locally tracked remaining rolls immediately after a claim instead of waiting behind a new global $tu cycle.",
      "Losing cross-account Kakera clicks now release their temporary power reservations without triggering a $tu request on every side account.",
      "Purple Kakera clicks now recognize Mudae's (Free) result format, require the account-specific confirmation, and retry when it is missing."
    ],
    "Improvements": [
      "Post-claim Purple Kakera discovery now watches delayed component updates for a longer window."
    ]
  },
