{
  "version": "4.7.1",
  "changelog": {
    "Automation": [
      "Kakera clicks can be limited to wished/starwished characters, with starwish detected from the series-line emoji.",
      "$mk can wait for full power, and auto-divorce can protect wished/starwished characters and series.",
      "Presets now support multiple farm characters, minute-precision inactive windows, and custom $oh/$oc strategies."
    ],
    "Multi-Account & Logging": [
      "One preset can securely run multiple Discord tokens, and settings can be applied across all presets without copying secrets.",
      "Kakera snipes can send a configurable follow-up chat message.",
      "Selected log types can be forwarded to a Discord webhook, with category filters for Expert Logs."
    ],
    "Bug Fixes": [
      "Perk 5 Kakera rolls now collect every eligible button instead of stopping early.",
      "Spanish claim cooldown messages can no longer be mistaken for a ready claim, preventing repeated claim attempts."
    ]
  },
