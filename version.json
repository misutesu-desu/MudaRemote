{
  "version": "4.9.0-beta.11",
  "changelog": {
    "Bug Fixes": [
      "Reset and cached-status scheduling now wakes at real availability boundaries instead of applying humanization or account staggering to them.",
      "Ambiguous own-roll claim clicks now verify and safely retry before the short server protection window expires."
    ],
    "Improvements": [
      "Reconnects promptly reconcile reset-bound status, and logs identify the exact MudaRemote version and runtime.",
      "Dynamic claim rounds, Fast Start, and per-Kakera power thresholds are clearer in the preset editor and logs."
    ]
  },
