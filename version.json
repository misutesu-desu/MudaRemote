{
  "version": "4.9.0-beta.23",
  "changelog": {
    "New": [
      "Large roll batches can now use the remaining time before a reset instead of skipping the entire cycle"
    ],
    "Improvements": [
      "Added reset-aware roll handoff when a reset happens during an active batch",
      "Old and new cycle roll counts remain separated during the transition",
      "Trusted successor cycles can continue without unnecessary $tu",
      "Unknown successor state requests one authoritative private sync",
      "Extra rolls and claim interruptions remain cycle-safe"
    ]
  },
