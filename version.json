  "version": "4.9.0-beta.12",
  "changelog": {
    "Bug Fixes": [
      "Auto $rolls now waits for the eligible claim-reset boundary and uses the restored claim without missing the claim hour.",
      "Hybrid Smart Panic Claim no longer spends $rt when the normal claim right is unavailable.",
      "Manual $rt acknowledgements now restore local claim state and prevent duplicate automatic $rt commands."
    ],
    "Improvements": [
      "Auto $rolls explanations now make wait, limit, interval, and eligibility decisions visible in debug logs."
    ]
  },
