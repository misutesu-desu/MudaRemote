{
  "version": "4.9.0-beta.25",
  "changelog": {
    "Bug Fixes": [
      "Fixed snipe-only profiles getting stuck forever during the initial handshake",
      "Restored startup status reconciliation required by snipe and OuroSphere features",
      "Fixed configured Round 3 panic fallback being blocked by normal minimum Kakera filtering",
      "Fixed Auto $rolls not recognizing an already available claim as a valid claim-hour condition",
      "Preserved explicit key-mode permission requirements for Auto $rolls"
    ],
    "Improvements": [
      "Snipe-only profiles perform the required authoritative startup check once and then reuse cached status",
      "Hybrid Panic and basic final-round panic fallback now remain distinct and follow their own configured rules",
      "Auto $rolls claim-hour logic is more consistent while still refusing to run when no claim is available"
    ]
  },
