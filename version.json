{
  "version": "4.9.0-beta.10",
  "changelog": {
    "Bug Fixes": [
      "Purple Kakera sniping: purple reactions now respect Target User IDs exactly like every other colour instead of bypassing the target list."
    ],
    "New Features": [
      "$mk Kakera Emojis: optional per-preset colour selection for $mk rolls (leave unchecked to inherit your regular Kakera Emojis).",
      "Purple Kakera clarity: ordinary purple buttons follow your selected Kakera colours, while Collect Purple Kakera now only controls automatic purple collection after your own claims."
    ],
    "Improvements": [
      "One colour rulebook: immediate clicks, end-of-batch priority clicks and external Kakera sniping all share a single roll-context selection path.",
      "MK Kakera Only combined with an explicitly empty $mk colour list is now rejected during preset validation."
    ]
  },
