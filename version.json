{
  "version": "4.8.6",
  "changelog": {
    "Bug Fixes": [
      "The bot keeps rolling after a claim reset without losing the roll that arrived at the boundary.",
      "Automatic rolls no longer get stuck or repeat status checks when Mudae recalculates the remaining reset time.",
      "$tu checks now wait for the configured active hours and a quiet channel before sending.",
      "Missing optional RT information no longer blocks the rest of the status update after the bot has warned you."
    ],
    "Improvements": [
      "After a $rolls confirmation, the bot continues with the remaining normal rolls immediately instead of starting another status cycle."
    ]
  },
