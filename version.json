{
  "version": "4.8.8",
  "changelog": {
    "Bug Fixes": [
      "Roll refreshes correctly when another account reaches a new roll hour, so exhausted accounts do not stay stuck on zero rolls.",
      "Snipe-only claim resets now keep your configured humanized timing instead of sending $tu exactly at the reset.",
      "Roll messages are reliably recognized when a saved channel ID is stored as text."
    ],
    "Improvements": [
      "Shared reset information now refreshes only the account data that needs it, keeping coordinated accounts responsive without unnecessary status checks."
    ]
  },
