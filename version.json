{
  "version": "4.9.0-beta.27",
  "changelog": {
    "Bug Fixes": [
      "Fixed Round 3 Auto $rolls being incorrectly treated as outside the claim hour when normal rolls replenished before the claim reset",
      "Auto $rolls can now correctly extend the final-round pool before panic claims consume the available claim",
      "Fixed Perk 8 / 10-key discounted Kakera being misclassified as normal Kakera",
      "Perk 8 Chaos Kakera no longer inherits normal power thresholds when no Chaos-specific threshold is configured"
    ],
    "Improvements": [
      "Normal rolls and Auto $rolls extension candidates remain pooled for final panic-claim evaluation",
      "Explicit Chaos thresholds such as chaos_kakeraY remain fully respected",
      "Perk 8 discount state is now preserved through the actual Kakera collection path"
    ]
  },
