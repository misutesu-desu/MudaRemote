{
  "version": "4.8.2",
  "changelog": {
    "Bug Fixes": [
      "Wishlist claims and snipe-only processing no longer stop with a missing roll_command error after startup.",
      "Free purple Kakera can now be collected before the first $tu power snapshot.",
      "Bulk $us now pulls the configured saved-roll allowance instead of stopping after one batch of 20.",
      "Interrupted $mk processing no longer causes repeated $tu refreshes."
    ],
    "Improvements": [
      "Smart Power Refill now has an optional Auto $dk trigger percentage; leave it at 0 to retain cost-based behavior."
    ]
  },
