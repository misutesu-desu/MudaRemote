{
  "version": "4.8.0",
  "changelog": {
    "Bug Fixes": [
      "Cached $tu status now expires before any longer claim or roll wait, preventing stale snapshots from leaving a preset asleep.",
      "$oc now follows the configured post-red colour priority and uses each colour's board geometry when choosing hidden rewards.",
      "Missing or unavailable sphere stocks shown as a dash are treated as zero instead of disrupting $oh and $oc automation."
    ],
    "Improvements": [
      "Auto $oh can optionally play every available use on a separate board while retaining multiplier batches as the default."
    ]
  },
