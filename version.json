  "version": "4.9.0-beta.20",
  "changelog": {
    "Bug Fixes": [
      "Reduced unnecessary $tu queue buildup around predictable reset boundaries.",
      "Prevented accounts with sufficient predicted state from consuming global $tu pacing slots.",
      "Reduced redundant per-account private status synchronization in large multi-account setups."
    ],
    "Improvements": [
      "Better scaling for 50+ account setups.",
      "Private $tu checks are now reserved for cases where authoritative per-account state is genuinely required.",
      "Verified Purple and Chaos Kakera filtering behavior against current preset settings."
    ]
  },
