  "version": "4.8.10-beta.2",
  "changelog": {
    "Bug Fixes": [
      "Automatically Use Saved Rolls refreshes status after complete or partially observed roll batches instead of sleeping on stale data, and recovers when an early $us acknowledgement still reports normal rolls.",
      "Snipe-only accounts ignore unrelated shared roll resets while known claim and RT deadlines remain usable during long roll batches.",
      "Forcedivorce farming now observes configured snipe channels and keeps before-roll and post-claim actions independent.",
      "Kakera clicks retry once when no account result arrives, and $oh preserves multiple late dark-to-purple bonus clicks.",
      "Portuguese $daily ready messages are recognized."
    ]
  },
