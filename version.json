{
  "version": "4.7.9",
  "changelog": {
    "Bug Fixes": [
      "Missing Chaos or Ouroperk 8 emoji overrides inherit the regular Kakera selection instead of silently re-enabling every colour.",
      "Ouroperk 8 uses its configured emoji list on both own and external rolls.",
      "Repeated four-button Kakera rolls are matched by position and emoji after Discord refreshes the message, avoiding skipped or wrong buttons.",
      "Red sphere buttons named sp or spR now match the same configured target, including doubled variants.",
      "An explicitly empty sphere target list remains empty instead of restoring runtime defaults.",
      "Preset clicks load synchronously, keep their selection when focus moves, and incomplete drafts save before navigation without snapping back to the previous preset.",
      "Save & Start Bot still requires a runtime-ready token and channel while normal Save Changes supports incomplete drafts."
    ],
    "Improvements": [
      "Quick Setup now offers wx, hx, and mx roll pools.",
      "The editor clearly labels Chaos and Ouroperk 8 lists as optional overrides that inherit regular Kakera choices when unchecked.",
      "Preset switching batches chip updates and reuses loaded emoji cards instead of rebuilding every option."
    ]
  },
