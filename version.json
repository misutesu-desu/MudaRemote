{
  "version": "4.9.0-beta.24",
  "changelog": {
    "Bug Fixes": [
      "Fixed $oh/$oc occasionally being sent to the roll channel instead of the configured command channel"
    ],
    "Improvements": [
      "Roll-related $tu checks are now aligned with the actual humanized roll target instead of always firing near reset",
      "Trusted roll state can proceed without unnecessary pre-roll $tu",
      "Unknown private roll state is reconciled closer to execution time",
      "High-account setups retain independently randomized preparation times instead of clustering status work at reset"
    ]
  },
