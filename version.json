{
  "version": "4.9.0-beta.15",
  "changelog": {
    "Bug Fixes": [
      "Known roll and claim reset cycles are now tracked locally instead of requiring /tu at every reset boundary.",
      "Fixed an edge case where Auto $rolls could be skipped when a new roll cycle started while the previous cycle was still finishing.",
      "Long roll batches no longer receive routine /tu checks in the middle of the batch.",
      "New roll-cycle availability is safely separated from an old batch that is still finishing.",
      "Automated $rolls commands are tracked more reliably during unusual Discord event ordering."
    ],
    "Improvements": [
      "Status synchronization now uses /tu only when fresh authoritative information is actually needed.",
      "Normal roll Humanization keeps a stable timing target while still leaving enough time to finish before the next reset.",
      "Rolls occurring close to a reset are handled conservatively without immediately forcing an unnecessary /tu while the result is still pending."
    ]
  },
