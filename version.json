{
  "version": "4.9.0-beta.21",
  "changelog": {
    "Bug Fixes": [
      "Fixed local reset prediction triggering rolls on the wrong minute.",
      "Fixed pending roll actions falling back into repeated $tu status loops.",
      "Fixed cases where authoritative rolls were repeatedly rediscovered without the scheduled action executing."
    ],
    "Improvements": [
      "Added an optional Server Reset Minute setting under Rolling Options.",
      "Configured reset minutes now override stale automatic roll-reset anchors.",
      "Automatic reset detection remains available when the setting is left empty.",
      "Pending roll actions now remain owned while waiting for their scheduled execution."
    ]
  },
